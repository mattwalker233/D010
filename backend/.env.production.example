# Production Environment Variables for Railway
# Copy this to Railway environment variables

# App Configuration
ENVIRONMENT=production
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=https://division-orderly.vercel.app,https://division-orderly-mwalker-3991s-projects.vercel.app
FRONTEND_URL=https://division-orderly.vercel.app

# Anthropic Claude API
ANTHROPIC_API_KEY=your_claude_api_key_here

# Database (Railway will provide these)
DATABASE_URL=postgresql://username:password@host:port/database

# Tesseract OCR (optional for production)
# TESSERACT_PATH=/usr/bin/tesseract

# File Storage
# For production, consider using cloud storage like AWS S3
# For now, using Railway's ephemeral storage 